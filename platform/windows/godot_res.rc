#include "core/version.h"

#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

GODOT_ICON ICON platform/windows/godot.ico
1 RT_MANIFEST "platform/windows/godot.manifest"

1 VERSIONINFO
FILEVERSION     GODOT_VERSION_MAJOR,GODOT_VERSION_MINOR,GODOT_VERSION_PATCH,0
PRODUCTVERSION  GODOT_VERSION_MAJOR,GODOT_VERSION_MINOR,GODOT_VERSION_PATCH,0
FILEOS          4
FILETYPE        1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // Atlas Studio (wolo/README.md, cambio 1): los metadatos del ejecutable.
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",            "Wolo Labs"
            VALUE "FileDescription",        "Atlas Studio"
            VALUE "FileVersion",            GODOT_VERSION_NUMBER
            VALUE "ProductName",            "Atlas Studio"
            VALUE "Licence",                "MIT"
            VALUE "LegalCopyright",         "Atlas Studio (c) Wolo Labs. Based on Godot Engine, (c) 2007-present Juan Linietsky, Ariel Manzur and Godot Engine contributors"
            VALUE "Info",                   "Based on Godot Engine, https://godotengine.org"
            VALUE "ProductVersion",         GODOT_VERSION_FULL_BUILD
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
